# SkiSense Configuration
# Copy this file to .env and adjust values as needed.
# All settings are optional; defaults are used when omitted.

# =============================================================================
# Processing Settings
# =============================================================================

# Debug mode: show detailed logs and warnings.
# Options: true, false
# Default: false
SKISENSE_DEBUG=false

# Show GUI preview window during processing.
# Options: true, false
# Default: false
SKISENSE_SHOW_GUI=false

# Device preference for PyTorch / Ultralytics inference.
# Options: auto, mps, cuda, cpu
#   - auto: Auto-detect (priority: MPS > CUDA > CPU)
#   - mps: Force Apple Silicon GPU
#   - cuda: Force NVIDIA GPU
#   - cpu: Force CPU
# Default: auto
SKISENSE_DEVICE=auto

# =============================================================================
# Detection & Tracking Settings
# =============================================================================

# YOLO person detection confidence threshold.
# Range: 0.0 - 1.0
# Default: 0.3
SKISENSE_YOLO_CONFIDENCE=0.3

# Deep SORT: max frames to keep a track alive without detection.
# Default: 30
SKISENSE_DEEPSORT_MAX_AGE=30

# Deep SORT: frames required to confirm a new track.
# Default: 1
SKISENSE_DEEPSORT_N_INIT=1

# Zoom target selection mode.
# Options:
#   - longest: pre-scan the video and lock zoom to the longest visible track
#   - largest: legacy behavior; prefer the current largest person bbox
# Default: longest
SKISENSE_TARGET_SELECTION_MODE=longest

# Minimum keypoint confidence for upper-body joints.
# Range: 0.0 - 1.0
# Default: 0.5
SKISENSE_POSE_VISIBILITY_THRESHOLD=0.5

# Minimum keypoint confidence for leg joints (hip, knee, ankle).
# Looser by default because ski postures heavily occlude the inside leg.
# Range: 0.0 - 1.0
# Default: 0.3
SKISENSE_POSE_VISIBILITY_THRESHOLD_LEGS=0.3

# ROI padding ratio: expand the person bbox before pose estimation.
# Range: 0.0 - 1.0 (0.3 = 30% expansion on each side)
# Default: 0.3
SKISENSE_ROI_PADDING=0.3

# =============================================================================
# Pose Model Settings
# =============================================================================

# Pose estimation backend. See docs/pose_backends.md for a full comparison.
#   - sam3d:  SAM 3D Body. 3D MHR-21 keypoints + mesh. CUDA required.
#             View-invariant joint angles incl. ankle. ~1-2 s/frame.
#   - yolo11: YOLO11-Pose. 2D COCO-17 keypoints. CPU/MPS/CUDA. Fast and
#             light, but no foot landmark (ankle angle shown as N/A).
#             This is the pre-migration engine, kept as a supported
#             fallback for machines without CUDA.
# This value is the persistent default; `run.py --pose-backend {sam3d,yolo11}`
# overrides it for a single run.
# Default: sam3d
SKISENSE_POSE_BACKEND=sam3d

# --- SAM 3D Body settings (used when SKISENSE_POSE_BACKEND=sam3d) -----------

# SAM 3D Body HuggingFace checkpoint repository.
# Options:
#   - facebook/sam-3d-body-dinov3 (840M, slightly stronger)
#   - facebook/sam-3d-body-vith   (631M, faster)
# Default: facebook/sam-3d-body-dinov3
# Note: Both repositories are gated. Request access on huggingface.co
#       and run `hf auth login` before first use.
SKISENSE_SAM3D_HF_REPO=facebook/sam-3d-body-dinov3

# Enable the optional hand-refinement decoder.
# Hands are not part of the ski-posture score, so the default disables
# this path to roughly halve VRAM and latency.
# Options: true, false
# Default: false
SKISENSE_SAM3D_USE_HAND_REFINE=false

# --- YOLO11-Pose settings (used when SKISENSE_POSE_BACKEND=yolo11) ----------

# YOLO11-Pose model filename. Options: yolo11n/s/m/l/x-pose.pt.
# Ultralytics auto-downloads on first run and caches under models/.
# Default: yolo11x-pose.pt
SKISENSE_YOLO_POSE_MODEL=yolo11x-pose.pt

# YOLO11-Pose keypoint confidence threshold.
# Range: 0.0 - 1.0
# Default: 0.25
SKISENSE_YOLO_POSE_CONFIDENCE=0.25

# Apply CLAHE (adaptive histogram equalization) to the ROI before pose
# estimation. May help low-contrast footage but can amplify snow noise.
# Options: true, false
# Default: false
SKISENSE_CLAHE_ENABLED=false

# Flip Test-Time Augmentation: also run pose on the horizontally flipped
# ROI and keep higher-confidence landmarks. Doubles inference time.
# Options: true, false
# Default: false
SKISENSE_FLIP_TTA_ENABLED=false

# =============================================================================
# Zoom Settings
# =============================================================================

# Enable automatic zoom to keep the skier centered.
# Options: true, false
# Default: true
SKISENSE_ZOOM_ENABLED=true

# Fallback zoom magnification level when dynamic area zoom cannot be computed.
# Range: 1.0 - 5.0
# Default: 1.2
SKISENSE_ZOOM_SCALE=1.2

# Zoom smoothing factor (kept for compatibility; detected targets are centered
# immediately in the current dynamic zoom implementation).
# Range: 0.0 - 1.0
# Default: 0.08
SKISENSE_ZOOM_SMOOTHING=0.08

# Padding multiplier around bounding box (reserved for future zoom variants).
# Range: 0.5 - 5.0
# Default: 1.0
SKISENSE_ZOOM_PADDING=1.0

# Target skier bbox area ratio after zoom.
# Range: 0.05 - 0.95 (0.35 = skier bbox fills about 35% of the frame area)
# Default: 0.35
SKISENSE_ZOOM_TARGET_AREA_RATIO=0.35

# Maximum dynamic zoom magnification.
# Range: 1.0 - 20.0
# Default: 5.0
SKISENSE_ZOOM_MAX_SCALE=5.0

# =============================================================================
# Common Development Configurations
# =============================================================================

# Development mode:
# SKISENSE_DEBUG=true
# SKISENSE_SHOW_GUI=true

# Production mode:
# SKISENSE_DEBUG=false
# SKISENSE_SHOW_GUI=false

# High confidence mode:
# SKISENSE_YOLO_CONFIDENCE=0.5

# Lower-VRAM mode (use the smaller ViT-H checkpoint):
# SKISENSE_SAM3D_HF_REPO=facebook/sam-3d-body-vith

# CUDA only (SAM 3D Body does not support CPU/MPS):
# SKISENSE_DEVICE=cuda
